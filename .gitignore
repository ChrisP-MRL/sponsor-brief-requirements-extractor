# Claude Code local settings
.claude/settings.local.json

# Excel templates (binary files - keep only the Python/YAML code)
*.xlsx
*.xls
*.xlsm

# Word documents
*.docx
*.doc

# PowerPoint documents
*.pptx

# ...but the skill templates are the point of this repo - keep them tracked
!.claude/skills/code-review/templates/*.pptx

# Per-concept working files - source notes in, generated deliverables out.
# This repo tracks the skills and scripts, not the artefacts they consume or produce.
input/
output/
build/

# Generated output
requirements/
raw data/
external/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/

# IDE
.vscode/
*.log

# Windows / OneDrive folder metadata
desktop.ini
Thumbs.db
