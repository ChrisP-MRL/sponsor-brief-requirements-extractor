def create_sponsor_brief_evaluator_skill():
    """
    Factory function to create and return the complete Sponsor Brief Evaluator Skill
    
    This is the main entry point for integrating with Claude or any AI platform.
    
    Returns:
        dict: Complete skill configuration including system prompt and functions
    """
    
    return {
        "skill_name": "Sponsor Brief Evaluator",
        "version": "1.0",
        "description": "Comprehensive evaluation of PRINCE2 Sponsor Briefs within DTS framework",
        "system_prompt": SYSTEM_PROMPT,
        "components": {
            "evaluator": SponsorBriefEvaluator(),
            "conversation_engine": ConversationFlowEngine(),
            "dimensions": DIMENSIONS,
            "quality_criteria": QUALITY_CRITERIA,
            "tier_thresholds": TIER_THRESHOLDS,
            "recommendations": RECOMMENDATION_TEMPLATES
        },
        "initial_prompt": ConversationFlowEngine().get_initial_greeting(),
        "conversation_flows": {
            "intake": "Gather brief and context",
            "dimensional_exploration": "Evaluate each dimension",
            "quality_validation": "Check mandatory criteria",
            "tier_verification": "Validate tier appropriateness",
            "recommendations": "Generate prioritized improvements",
            "reporting": "Deliver comprehensive evaluation"
        },
        "metadata": {
            "created": datetime.now().isoformat(),
            "framework": "PRINCE2 + DTS",
            "tiers_supported": ["Minor Works", "Small Projects", "Standard", "Major"],
            "dimensions": list(DIMENSIONS.keys()),
            "disciplines": ["IT Infrastructure", "Applications", "AI/Automation", "Cyber"]
        }
    }


