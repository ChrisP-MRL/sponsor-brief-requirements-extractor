# ============================================================================
# MAIN SKILL CLASS
# ============================================================================

class SponsorBriefEvaluator:
    """
    Main class for Sponsor Brief evaluation within DTS framework
    """

    def __init__(self):
        self.current_context = None
        self.current_brief = None
        self.evaluation_result = None

    def format_system_prompt(self):
        """Return the system prompt for Claude"""
        return SYSTEM_PROMPT

    def create_initial_intake_prompt(self):
        """Create the initial user-facing prompt for intake"""
        return """
# Welcome to the Sponsor Brief Evaluator 🚀

I'm ready to help you evaluate a PRINCE2 Sponsor Brief against DTS quality standards and the four-tier project categorization model.

**Here's how this works:**

1. **You'll share your brief** (copy-paste the text or describe it)
2. **I'll gather context** through a brief conversation (project tier expectation, delivery discipline, organizational context)
3. **I'll systematically evaluate** across six dimensions: Execution Risk, Complexity, Familiarity & Repeatability, Reputation & Stakeholder Risk, Technology Maturity, and Business Change Impact
4. **I'll identify gaps** and provide specific recommendations
5. **You'll get a comprehensive report** with scoring, tier estimate, and prioritized improvements

**To get started:**

Please share your Sponsor Brief (paste the full text if possible, or describe it in detail). Then I'll ask a few clarifying questions to understand the context.

What brief would you like to evaluate?
"""

    def parse_brief_and_context(self, brief_text: str) -> BriefContext:
        """
        Parse brief text to extract contextual information
        """
        context = BriefContext(
            project_name=self._extract_project_name(brief_text),
            expected_tier=None,
            delivery_discipline=None,
            organizational_context="",
            budget_estimate=self._extract_budget(brief_text),
            timeline_estimate=self._extract_timeline(brief_text),
            stakeholder_count=self._count_stakeholders(brief_text)
        )
        return context

    def _extract_project_name(self, text: str) -> str:
        """Extract project name from brief"""
        lines = text.split('\n')
        # Look for common patterns like "Project:", "Title:", or first substantial line
        for line in lines[:5]:
            if any(keyword in line.lower() for keyword in ['project', 'title', 'name']):
                return line.replace('Project:', '').replace('Title:', '').replace('Name:', '').strip()
        return "Unnamed Project"

    def _extract_budget(self, text: str) -> Optional[str]:
        """Extract budget information"""
        # Pattern matching for currency amounts
        import re
        patterns = [
            r'\$\s*[\d,]+(?:\.\d{2})?(?:\s*[KMB])?',
            r'£\s*[\d,]+(?:\.\d{2})?(?:\s*[KMB])?',
            r'budget[:\s]+\$?\s*[\d,]+(?:\.\d{2})?(?:\s*[KMB])?',
            r'cost[:\s]+\$?\s*[\d,]+(?:\.\d{2})?(?:\s*[KMB])?'
        ]
        for pattern in patterns:
            match = re.search(pattern, text, re.IGNORECASE)
            if match:
                return match.group(0).strip()
        return None

    def _extract_timeline(self, text: str) -> Optional[str]:
        """Extract timeline information"""
        patterns = [
            r'(\d+)\s*(?:month|week|day|year)s?',
            r'(Q[1-4]\s*\d{4})',
            r'(\d{1,2}/\d{1,2}/\d{4})',
            r'timeline[:\s]+(.*?)(?:\n|$)'
        ]
        for pattern in patterns:
            match = re.search(pattern, text, re.IGNORECASE)
            if match:
                return match.group(0).strip()
        return None

    def _count_stakeholders(self, text: str) -> int:
        """Estimate stakeholder count"""
        stakeholder_keywords = ['sponsor', 'manager', 'team', 'department', 'user', 'stakeholder', 'customer']
        count = 0
        for keyword in stakeholder_keywords:
            count += text.lower().count(keyword)
        return min(count, 10)  # Cap at 10 for estimation

    def evaluate_dimension(self, dimension_name: str, brief_text: str) -> DimensionalAssessment:
        """
        Evaluate a single dimension
        Returns a DimensionalAssessment with score, evidence, and gaps
        """
        # This would integrate with Claude in production
        # For now, provide a template structure
        pass

    def calculate_total_score(self, dimensional_scores: Dict[str, int]) -> int:
        """
        Calculate total score from dimensional scores
        """
        return sum(dimensional_scores.values())

    def determine_tier(self, total_score: int) -> str:
        """
        Determine project tier based on total score
        """
        for tier_name, (min_score, max_score) in TIER_THRESHOLDS.items():
            if min_score <= total_score <= max_score:
                return tier_name
        return "Major"  # Default to Major if score exceeds all thresholds

    def apply_escalation_rules(self, dimensional_scores: Dict[str, int], tier: str) -> Tuple[str, str]:
        """
        Apply DTS escalation rules
        Any dimension scoring 4 escalates project one tier
        Returns: (adjusted_tier, escalation_reason)
        """
        escalation_dimensions = [dim for dim, score in dimensional_scores.items() if score == 4]
        
        if escalation_dimensions:
            tier_order = ["Minor Works", "Small Projects", "Standard", "Major"]
            current_index = tier_order.index(tier)
            
            if current_index < 3:  # Don't escalate beyond Major
                escalated_tier = tier_order[current_index + 1]
                reason = f"Automatic escalation: {', '.join(escalation_dimensions)} scored 4"
                return escalated_tier, reason
        
        return tier, "No escalation needed"

    def generate_recommendations(self, dimensional_scores: Dict[str, int], 
                                quality_gaps: List[str]) -> Dict[str, List[str]]:
        """
        Generate prioritized recommendations based on evaluation
        """
        recommendations = {
            "critical": [],
            "significant": [],
            "enhancement": []
        }

        for dimension, score in dimensional_scores.items():
            if score >= 3 and dimension in RECOMMENDATION_TEMPLATES:
                template = RECOMMENDATION_TEMPLATES[dimension].get(score, {})
                if "critical" in template:
                    recommendations["critical"].append(template["critical"])
                if "significant" in template:
                    recommendations["significant"].append(template["significant"])
                if "enhancement" in template:
                    recommendations["enhancement"].append(template["enhancement"])

        return recommendations

    def generate_smart_assessment(self, brief_text: str) -> Dict[str, str]:
        """
        Assess SMART criteria for the brief
        """
        assessment = {}
        criteria = ["Specific", "Measurable", "Achievable", "Realistic", "Time-bound"]
        
        for criterion in criteria:
            # In production, Claude would assess each criterion
            assessment[criterion] = "Assessment would be generated by Claude"
        
        return assessment

    def create_evaluation_report(self, brief_text: str, context: BriefContext, 
                                dimensional_scores: Dict[str, int]) -> str:
        """
        Create a comprehensive evaluation report
        """
        total_score = self.calculate_total_score(dimensional_scores)
        initial_tier = self.determine_tier(total_score)
        final_tier, escalation_reason = self.apply_escalation_rules(dimensional_scores, initial_tier)

        report = f"""
# SPONSOR BRIEF EVALUATION REPORT
Generated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}

## EXECUTIVE SUMMARY

**Project:** {context.project_name}
**Delivery Discipline:** {context.delivery_discipline or 'Not specified'}
**Expected Budget:** {context.budget_estimate or 'Not provided'}
**Expected Timeline:** {context.timeline_estimate or 'Not provided'}
**Stakeholder Count:** {context.stakeholder_count}

---

## DIMENSIONAL ASSESSMENT

**Total Score:** {total_score}
**Estimated Tier (before escalation):** {initial_tier}
**Final Tier (after escalation rules):** {final_tier}
**Escalation Status:** {escalation_reason}

### Dimensional Breakdown:

"""
        for dimension, score in dimensional_scores.items():
            report += f"\n#### {dimension}: {score}/4\n"
            report += f"Description: {DIMENSIONS[dimension][score]['description']}\n"

        report += f"""

---

## QUALITY ASSESSMENT

### SMART Criteria

"""
        smart_assessment = self.generate_smart_assessment(brief_text)
        for criterion, assessment in smart_assessment.items():
            report += f"- **{criterion}:** {assessment}\n"

        report += f"""

### Mandatory Quality Criteria

"""
        for criteria_name, criteria_details in QUALITY_CRITERIA.items():
            report += f"- **{criteria_name}:** [Assessment would be provided by Claude]\n"

        return report

# ============================================================================
# CONVERSATION FLOW ENGINE
# ============================================================================

class ConversationFlowEngine:
    """
    Manages the multi-turn conversation flow for brief evaluation
    """

    def __init__(self):
        self.evaluator = SponsorBriefEvaluator()
        self.conversation_state = "INTAKE"
        self.context = None
        self.brief_text = None

    def get_initial_greeting(self) -> str:
        """Return initial greeting"""
        return self.evaluator.create_initial_intake_prompt()

    def process_brief_submission(self, brief_text: str) -> str:
        """Process brief submission and move to context gathering"""
        self.brief_text = brief_text
        self.context = self.evaluator.parse_brief_and_context(brief_text)
        self.conversation_state = "CONTEXT_GATHERING"

        response = f"""
Great! I've received your brief for "{self.context.project_name}".

I can see this involves approximately {self.context.stakeholder_count} stakeholder group(s), 
an estimated budget around {self.context.budget_estimate or 'TBD'}, 
and a timeline of roughly {self.context.timeline_estimate or 'not yet specified'}.

Now, let me ask a few clarifying questions to ensure my evaluation is properly contextualized:

1. **Project Tier Expectation:** Do you initially expect this to be Minor Works (6-8), Small (9-12), 
   Standard (13-17), or Major (18-24)?

2. **Delivery Discipline:** Which discipline? IT Infrastructure, Applications, AI/Automation, or Cyber?

3. **Organizational Context:** Any specific organizational priorities, recent changes, or constraints 
   I should know about?

4. **Anything Else:** Any other context that would help me evaluate this fairly?

This helps calibrate whether the brief's depth and detail are appropriate to the project's true risk and tier.
"""
        return response

    def process_context_input(self, user_input: str) -> str:
        """Process context input and move to evaluation"""
        # Parse user input for context clues
        if "minor" in user_input.lower() or "6" in user_input or "7" in user_input or "8" in user_input:
            self.context.expected_tier = "Minor Works"
        elif "small" in user_input.lower() or "9" in user_input or "10" in user_input or "12" in user_input:
            self.context.expected_tier = "Small Projects"
        elif "standard" in user_input.lower() or "13" in user_input or "17" in user_input:
            self.context.expected_tier = "Standard"
        elif "major" in user_input.lower() or "18" in user_input or "24" in user_input:
            self.context.expected_tier = "Major"

        if "infrastructure" in user_input.lower():
            self.context.delivery_discipline = "IT Infrastructure"
        elif "application" in user_input.lower():
            self.context.delivery_discipline = "Applications"
        elif "ai" in user_input.lower() or "automation" in user_input.lower():
            self.context.delivery_discipline = "AI/Automation"
        elif "cyber" in user_input.lower():
            self.context.delivery_discipline = "Cyber"

        self.context.organizational_context = user_input

        self.conversation_state = "EVALUATION"

        response = f"""
Perfect! Thank you for that context.

**Context Summary:**
- Expected Tier: {self.context.expected_tier or 'To be determined'}
- Delivery Discipline: {self.context.delivery_discipline or 'To be determined'}
- Organizational Context: {self.context.organizational_context[:100]}...

Now I'll conduct a comprehensive evaluation across the six DTS dimensions. I'll examine your brief 
for evidence of risk, complexity, familiarity, stakeholder visibility, technology maturity, and 
organizational change impact.

Let me start with **Execution Risk**: {self._create_dimension_exploration("Execution Risk")}
"""
        return response

    def _create_dimension_exploration(self, dimension: str) -> str:
        """Create exploration prompt for a dimension"""
        if dimension == "Execution Risk":
            return """

Your brief describes delivering a [project description]. 

On a scale of 1-4:
- **1** = Routine; low chance of failure; minimal obstacles
- **2** = Some risk but manageable with standard controls  
- **3** = Significant risk requiring active management
- **4** = High risk requiring intensive control

**How would you characterize the execution risk for this project?** And are there specific obstacles 
or challenges the brief should articulate more clearly?
"""

    def generate_final_report(self) -> str:
        """Generate the final evaluation report"""
        if not self.brief_text or not self.context:
            return "Error: No brief or context available for reporting"

        # In production, Claude would generate comprehensive dimensional scores
        sample_dimensional_scores = {
            "Execution Risk": 2,
            "Complexity": 2,
            "Familiarity & Repeatability": 2,
            "Reputation & Stakeholder Risk": 1,
            "Technology Maturity": 1,
            "Business Change Impact": 1
        }

        report = self.evaluator.create_evaluation_report(
            self.brief_text,
            self.context,
            sample_dimensional_scores
        )

        return report


